{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kilnworth-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "shop.helban.dev", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls back into its own worker; the service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kilnworth-storefront"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kilnworth",
      // Local dev and tests use a local copy under .next/cache and never contact this database.
      "database_id": "3b569ee7-ea06-43dd-bdcf-45bcbaac16d9",
      "migrations_dir": "migrations"
    }
  ]
}
