{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kilnworth-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls back into its own worker; the service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kilnworth-storefront"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kilnworth",
      // Placeholder. Local dev and tests never contact Cloudflare. Replace with the id from
      // `wrangler d1 create kilnworth` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
